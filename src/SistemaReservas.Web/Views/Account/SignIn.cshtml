@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<section class="auth-shell">
    <div class="auth-card-split">
        <article class="auth-pane auth-form-pane">
            <div class="auth-heading">
                <h1>Sign in</h1>
                <p>Access your SmartReserve account.</p>
            </div>

            <form id="loginForm" class="stack-form auth-form">
                <label>Email<input type="email" name="email" placeholder="you@example.com" required /></label>
                <label>Password<input type="password" name="password" placeholder="Enter your password" required /></label>
                <button type="submit">Login</button>
            </form>

            <div id="authResult" class="auth-feedback"></div>
            <p class="small-note auth-note">No account yet? <a asp-route="signup">Sign up</a></p>
        </article>

        <aside class="auth-pane auth-visual-pane">
            <img class="auth-side-image" src="~/assets/login.jpg" alt="SmartReserve login illustration" />
            <h2>Welcome back</h2>
            <p>Sign in to continue managing your business and reservations.</p>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        SmartReservePortal.initSignInPage();
    </script>
}
