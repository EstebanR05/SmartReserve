@{
    ViewData["Title"] = "Recovery";
}

<section class="auth-shell">
    <div class="auth-card-split">
        <article class="auth-pane auth-form-pane">
            <div class="auth-heading">
                <h1>Password recovery</h1>
                <p>Enter your email and we will send a recovery message.</p>
            </div>

            <form id="forgotPasswordForm" class="stack-form auth-form">
                <label>Email<input type="email" name="email" placeholder="you@example.com" required /></label>
                <button type="submit" class="secondary">Send recovery email</button>
            </form>

            <div id="authResult" class="auth-feedback"></div>
            <p class="small-note auth-note">Remembered your password? <a asp-controller="Account" asp-action="SignIn">Sign in</a></p>
        </article>

        <aside class="auth-pane auth-visual-pane">
            <div class="auth-illustration">
                <div class="stat-card">
                    <span class="dot"></span>
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
                <div class="chart-wave"></div>
                <div class="auth-badge">Recovery</div>
            </div>
            <h2>Account protection</h2>
            <p>Security first. Recover access safely and continue your work.</p>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        SmartReservePortal.initRecoveryPage();
    </script>
}
