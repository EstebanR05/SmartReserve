@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-shell">
    <div class="dashboard-card">
        <h1>Dashboard</h1>
        <p>This area is ready for your next modules.</p>
        <button type="button" class="secondary" id="logoutBtn">Sign Out</button>
    </div>
</section>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        SmartReservePortal.initPortalHome();
        document.getElementById("logoutBtn")?.addEventListener("click", function () {
            SmartReservePortal.clearToken();
            window.location.href = "/Account/SignIn";
        });
    </script>
}
