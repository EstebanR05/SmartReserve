@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sistema de Reservas";
}

<section class="legacy-shell">
    <div class="sr-app-shell">
        <aside class="sr-plus-sidebar">
            <div class="sr-plus-profile">
                <div class="sr-plus-avatar">SR</div>
                <div>
                    <strong>SmartReserve</strong>
                    <small>Administrador</small>
                </div>
            </div>

            <nav class="sr-plus-nav">
                <button class="legacy-nav-link is-active sr-plus-link" data-view="sites">Sedes Recreativas</button>
                <button class="legacy-nav-link sr-plus-link" data-view="my-reservations">Mis Reservas</button>
            </nav>

            <button class="sr-plus-logout" id="logoutBtn">Cerrar Sesión</button>
        </aside>

        <section class="sr-plus-main">
            <header class="sr-plus-topbar">
                <h1>Sistema de Reservas</h1>
                <span class="legacy-user" id="legacyUser">Bienvenido</span>
            </header>

            <main class="legacy-content">
        <section id="view-sites" class="legacy-view is-active">
            <h2>Sedes Recreativas y Apartamentos</h2>

            <div class="legacy-tabs">
                <button class="legacy-tab is-active" data-panel="list">Sedes Recreativas y Apartamentos</button>
                <button class="legacy-tab" data-panel="dates">Seleccione sus Fechas</button>
            </div>

            <section id="panel-list" class="legacy-panel is-active">
                <table class="legacy-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Tipo</th>
                            <th>Ubicación</th>
                            <th>Seleccionar</th>
                        </tr>
                    </thead>
                    <tbody id="sitesTableBody"></tbody>
                </table>
            </section>

            <section id="panel-dates" class="legacy-panel">
                <div class="legacy-dates-grid">
                    <article class="legacy-card">
                        <h3>Mis Fechas</h3>
                        <form id="availabilityForm" class="legacy-form">
                            <label>Fecha de Llegada<input name="checkInDate" type="date" required /></label>
                            <label>Fecha de Salida<input name="checkOutDate" type="date" required /></label>
                            <label>Noches<input name="nights" type="number" min="1" required /></label>
                            <label>Personas<input name="people" type="number" min="1" required /></label>
                            <label>Nombre de Contacto<input name="contactFullName" required /></label>
                            <label>Email de Contacto<input name="contactEmail" type="email" required /></label>
                            <label>Teléfono de Contacto<input name="contactPhone" /></label>
                            <button type="submit" class="legacy-btn">Consultar Disponibilidad</button>
                        </form>

                        <div class="legacy-total">
                            <h3>Total Reserva</h3>
                            <div>Habitaciones: <strong id="summaryRooms">0</strong></div>
                            <div>Días Ordinarios: <strong id="summaryOrdinary">0</strong></div>
                            <div>Días Especiales: <strong id="summarySpecial">0</strong></div>
                            <div>Valor Total: <strong id="summaryTotal">$0</strong></div>
                        </div>
                    </article>

                    <article class="legacy-card">
                        <h3 id="selectedSiteTitle">Seleccione una sede</h3>
                        <label class="legacy-site-picker">
                            Sede
                            <select id="siteSelect">
                                <option value="">Seleccione una sede...</option>
                            </select>
                        </label>
                        <p id="selectedSiteDescription" class="legacy-scroll"></p>

                        <table class="legacy-table legacy-table-sm">
                            <thead>
                                <tr>
                                    <th>Habitación / Alojamiento</th>
                                    <th>Capacidad</th>
                                    <th>Tarifa</th>
                                    <th>Disponible</th>
                                    <th>Reservar</th>
                                </tr>
                            </thead>
                            <tbody id="unitsTableBody"></tbody>
                        </table>

                        <button id="openConfirmBtn" type="button" class="legacy-btn" disabled>Reservar</button>
                    </article>
                </div>
            </section>
        </section>

        <section id="view-my-reservations" class="legacy-view">
            <h2>Mis Reservas</h2>
            <table class="legacy-table">
                <thead>
                    <tr>
                        <th>Lugar</th>
                        <th>Fecha Reserva</th>
                        <th>Fecha Llegada</th>
                        <th>Fecha Salida</th>
                        <th>No. Personas</th>
                        <th>No. Habitaciones</th>
                        <th>Valor Total</th>
                        <th>Cancelar</th>
                    </tr>
                </thead>
                <tbody id="myReservationsBody"></tbody>
            </table>
        </section>
            </main>
            <footer class="sr-plus-footer">
                SmartReserve - Plataforma de Reservas
            </footer>
        </section>
    </div>

    <div id="unitModal" class="legacy-modal hidden">
        <div class="legacy-modal-card">
            <header>
                <h4>Detalle Habitación / Alojamiento</h4>
                <button type="button" data-close="unitModal">X</button>
            </header>
            <div id="unitModalBody"></div>
        </div>
    </div>

    <div id="confirmModal" class="legacy-modal hidden">
        <div class="legacy-modal-card">
            <header>
                <h4>Confirmación Reserva</h4>
                <button type="button" data-close="confirmModal">X</button>
            </header>
            <div id="confirmBody"></div>
            <div class="legacy-modal-actions">
                <button id="confirmReservationBtn" type="button" class="legacy-btn">Confirmar</button>
                <button type="button" class="legacy-btn secondary" data-close="confirmModal">Cancelar</button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        SmartReservePortal.initPortalHome();
    </script>
}
