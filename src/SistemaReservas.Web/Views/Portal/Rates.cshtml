@{
    ViewData["Title"] = "Rates";
}

<section class="page-header">
    <h1>Rates and Calculation</h1>
    <p>Tests rate lookup and total amount calculation stored procedures.</p>
</section>

<section class="form-grid">
    <article class="form-card">
        <h2>Search Rates</h2>
        <form id="ratesSearchForm" class="stack-form">
            <label>Tourist Site Id<input type="number" name="touristSiteId" min="1" required /></label>
            <label>Reference Date<input type="date" name="referenceDate" required /></label>
            <label>People<input type="number" name="people" min="1" required /></label>
            <label>Accommodation Type Id<input type="number" name="accommodationTypeId" min="1" required /></label>
            <label>Accommodation Unit Id (optional)<input type="number" name="accommodationUnitId" min="1" /></label>
            <button type="submit">Search Rates</button>
        </form>
    </article>

    <article class="form-card">
        <h2>Calculate Total</h2>
        <form id="ratesCalculateForm" class="stack-form">
            <label>Tourist Site Id<input type="number" name="touristSiteId" min="1" required /></label>
            <label>Reference Date<input type="date" name="referenceDate" required /></label>
            <label>People<input type="number" name="people" min="1" required /></label>
            <label>Accommodation Type Id<input type="number" name="accommodationTypeId" min="1" required /></label>
            <label>Room Count<input type="number" name="roomCount" min="1" required /></label>
            <label>Nights<input type="number" name="nights" min="1" required /></label>
            <button type="submit">Calculate</button>
        </form>
    </article>
</section>

<section class="result-section">
    <h2>Response</h2>
    <pre id="ratesResult" class="result-box"></pre>
</section>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        SmartReservePortal.initRatesPage();
    </script>
}
