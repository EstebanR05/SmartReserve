@{
    ViewData["Title"] = "Availability";
}

<section class="page-header">
    <h1>Availability Search</h1>
    <p>Tests <code>POST /api/availability/search</code>.</p>
</section>

<section class="form-grid single">
    <article class="form-card">
        <h2>Search Criteria</h2>
        <form id="availabilityForm" class="stack-form">
            <label>Tourist Site Id<input type="number" name="touristSiteId" min="1" required /></label>
            <label>Check-in Date<input type="date" name="checkInDate" required /></label>
            <label>Check-out Date<input type="date" name="checkOutDate" required /></label>
            <label>People (optional)<input type="number" name="people" min="1" /></label>
            <button type="submit">Search Availability</button>
        </form>
    </article>
</section>

<section class="result-section">
    <h2>Response</h2>
    <pre id="availabilityResult" class="result-box"></pre>
</section>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        SmartReservePortal.initAvailabilityPage();
    </script>
}
